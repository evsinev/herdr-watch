# Runtime image built from the Quarkus fast-jar (layered) layout.
# COPY order goes from the most stable / largest layer to the most volatile one,
# so the ~18 MB `lib/` dependency layer keeps its digest across builds and the
# registry only stores/pushes the small `app/` + `quarkus/` layers that actually
# change. The fast-jar is produced beforehand (`./mvnw package`) and its
# `quarkus-app/` directory is placed into this build context.
FROM eclipse-temurin:21-jre
WORKDIR /deployments

COPY quarkus-app/lib/     /deployments/lib/
COPY quarkus-app/*.jar    /deployments/
COPY quarkus-app/app/     /deployments/app/
COPY quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
